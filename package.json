{
  "name": "iti",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:prod": "vite build --mode production",
    "server": "vite preview --port 3000",
    "deploy": "bash deploy.sh",
    "deploy:win": "deploy.bat",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist",
    "deploy:vercel": "npm run build && vercel --prod",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist",
    "test:build": "npm run build && npm run preview",
    "clean": "rm -rf dist node_modules package-lock.json && npm install"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@popperjs/core": "^2.11.8",
    "@sendgrid/mail": "^8.1.5",
    "@tailwindcss/vite": "^4.1.11",
    "bootstrap": "^5.3.7",
    "firebase": "^12.0.0",
    "pinia": "^2.1.7",
    "terser": "^5.43.1",
    "vue": "^3.5.17",
    "vue-carousel": "^0.18.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "imagemin": "^9.0.1",
    "imagemin-cli": "^8.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^11.0.1",
    "postcss": "^8.5.6",
    "sass-embedded": "^1.89.2",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
